// test.hvr
.tran(0, 40m, 1u, 2u);
.save(
    main.out,
    main.sig

);
.solver(bdf2);

from "./analog/opamp" import OpAmp;
import <math> as Math;


analog module main<>()[]
{
    wire pos, neg, vdd, out, minus;
    
    double sig = 1.5* Math.sin(2*3.14*1k*time);

    voltage_source<>(sig)[pos, gnd];    
    module opamp = OpAmp<10e8, 10e8, 10e5>()[minus,  pos, out];

    R<1k>()[minus, gnd];
    R<1k>()[out, minus];
    R<1k>()[out, gnd];
}
