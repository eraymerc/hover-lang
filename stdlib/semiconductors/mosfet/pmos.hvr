from <math> import fabs, sqrt, pnjlim, jexp, vcrit_of, q_dep;

// ─────────────────────────────────────────────────────────────────────────────
//  P-Channel MOSFET — SPICE Level 1 (Shichman-Hodges)
//
//  The mirror of nmos.hvr, which carries the full explanation of every piece:
//  the four-terminal core with its three-terminal wrapper, RD/RS and the
//  intrinsic di/si nodes, fetlim/limvds limiting, the mode-before-threshold
//  ordering, (1 + LAMBDA*Vds) in both regions, the two bulk junctions with
//  GMIN, the Meyer capacitances, and why the old Rpar companion resistor is
//  gone. Read that file first; only the polarity is discussed here.
//
//  ── Parameter sign convention ───────────────────────────────────────────────
//
//  VTO is passed NEGATIVE, exactly as it appears on a manufacturer's .model
//  card for a P-channel part. KP, GAMMA, PHI and LAMBDA stay positive, also as
//  on the card. This is a change from an earlier revision of this file, which
//  asked for Vth as a magnitude; the point of using SPICE's parameter names is
//  that a card transcribes without translation, and inventing a sign rule of
//  our own would defeat that.
//
//  ── How the polarity is implemented ─────────────────────────────────────────
//
//  The same way SPICE does it: a type sign of -1 is applied to every terminal
//  voltage and to VTO on the way in, the N-channel equations run unchanged in
//  the resulting coordinates, and the resulting current is stamped in the
//  reversed terminal order on the way out. So the device turns on when the gate
//  is pulled BELOW the source, and conventional current flows source -> drain.
//
//  Concretely, every "_n" quantity below is source-referenced downward
//  (V(source) - V(x)) rather than upward, and vto_n = -VTO is positive for any
//  ordinary part. Nothing else in the model needs to know about polarity.
//
//  ── Bulk ────────────────────────────────────────────────────────────────────
//
//  The bulk is the n-well. Its junctions to the p-type source and drain conduct
//  when those terminals rise ABOVE the well, which is the reverse of the NMOS —
//  and with the well tied to the source (the PMOS wrapper below) the bulk-drain
//  junction becomes the intrinsic body diode, clamping the drain to just above
//  the source rail. That is exactly the high-side recirculation path in a
//  bridge.
// ─────────────────────────────────────────────────────────────────────────────

analog module PMOS4<double VTO,  double KP,   double GAMMA, double PHI, double LAMBDA,
                    double W,    double L,    double LD,
                    double RD,   double RS,
                    double TOX,  double CGSO, double CGDO,  double CGBO,
                    double IS,   double N,    double PB,
                    double CBD,  double CBS,  double CJ,    double MJ,
                    double CJSW, double MJSW, double FC,    double TT,
                    double AD,   double ASRC, double PD,    double PSRC,
                    double VT>()
    [wire gate, wire drain, wire source, wire bulk]
{
    wire di, si;

    R<RD>() [drain,  di];
    R<RS>() [source, si];

    double Leff = L - 2.0 * LD;
    double Beta = KP * W / Leff;

    double COX = 0.0;
    if (TOX > 0.0) { COX = 3.4531e-11 * W * Leff / TOX; }

    double nvt   = N * VT;
    double is_j  = IS;
    if (is_j <= 0.0) { is_j = 1.0e-14; }
    double vcrit = vcrit_of(is_j, nvt);

    // Threshold in the flipped coordinates: positive for an ordinary P-channel
    // card, which is what the N-channel equations below expect.
    double vto_n = 0.0 - VTO;

    // ── limvds, and the mode it selects ─────────────────────────────────────
    double vds_true = V(si) - V(di);
    double vds_old  = nr_prev(V(si) - V(di));

    double dvd_max = 2.0 * fabs(vds_old) + 2.0;
    double dvd     = vds_true - vds_old;
    if (dvd >  dvd_max) { dvd =  dvd_max; }
    if (dvd < -dvd_max) { dvd = -dvd_max; }
    double vds = vds_old + dvd;

    double flip = 1.0;
    if (vds < 0.0) { flip = -1.0; }

    // ── Threshold with body effect ──────────────────────────────────────────
    double vbs_eff = V(si) - V(bulk);
    if (flip < 0.0) { vbs_eff = V(di) - V(bulk); }

    double sqphi = sqrt(PHI);
    double sarg  = sqphi;
    if (vbs_eff <= 0.0) {
        sarg = sqrt(PHI - vbs_eff);
    } else {
        sarg = sqphi / (1.0 + vbs_eff / (2.0 * PHI));
    }
    double von = vto_n + GAMMA * (sarg - sqphi);

    // ── fetlim ──────────────────────────────────────────────────────────────
    double vgs_true = V(si) - V(gate);
    double vgs_old  = nr_prev(V(si) - V(gate));

    double dvg_max = 2.0 * fabs(vgs_old - von) + 2.0;
    double dvg     = vgs_true - vgs_old;
    if (dvg >  dvg_max) { dvg =  dvg_max; }
    if (dvg < -dvg_max) { dvg = -dvg_max; }
    double vgs = vgs_old + dvg;

    // ── Channel current ─────────────────────────────────────────────────────
    double vch  = vds * flip;
    double vgst = vgs - von;
    if (flip < 0.0) { vgst = vgs - vds - von; }

    if (vgst > 20.0) { vgst = 20.0; }

    double vdsat = vgst;
    if (vdsat < 0.0) { vdsat = 0.0; }

    double cdrain = 0.0;
    if (vgst > 0.0) {
        double betap = Beta * (1.0 + LAMBDA * vch);
        if (vch < vdsat) {
            cdrain = betap * vch * (vgst - 0.5 * vch);   // triode
        } else {
            cdrain = 0.5 * betap * vgst * vgst;          // saturation
        }
    }
    cdrain = cdrain * flip;

    // Reversed terminal order relative to the NMOS: a positive cdrain is
    // current flowing source -> drain through the channel, the PMOS on-state.
    current_source<>(cdrain) [si, di];

    // ── Bulk junctions ──────────────────────────────────────────────────────
    // Forward voltages are measured terminal-above-well, the reverse of the
    // NMOS, and the currents flow out of the terminal into the well.
    double vbs_l = pnjlim(V(si) - V(bulk), nr_prev(V(si) - V(bulk)), nvt, vcrit);
    double vbd_l = pnjlim(V(di) - V(bulk), nr_prev(V(di) - V(bulk)), nvt, vcrit);

    double ibs = is_j * (jexp(vbs_l, nvt) - 1.0);
    double ibd = is_j * (jexp(vbd_l, nvt) - 1.0);

    double ibs_g = ibs + 1.0e-12 * vbs_l;
    double ibd_g = ibd + 1.0e-12 * vbd_l;
    current_source<>(ibs_g) [si, bulk];
    current_source<>(ibd_g) [di, bulk];

    double cbd_eff = CBD;
    if (cbd_eff <= 0.0) { cbd_eff = CJ * AD; }
    double cbs_eff = CBS;
    if (cbs_eff <= 0.0) { cbs_eff = CJ * ASRC; }

    // Raw, unlimited voltages — see nmos.hvr and diode.hvr for why.
    double vbs_raw = V(si) - V(bulk);
    double vbd_raw = V(di) - V(bulk);

    double qbs = q_dep(vbs_raw, cbs_eff,     PB, MJ,   FC)
               + q_dep(vbs_raw, CJSW * PSRC, PB, MJSW, FC)
               + TT * ibs;
    double qbd = q_dep(vbd_raw, cbd_eff,   PB, MJ,   FC)
               + q_dep(vbd_raw, CJSW * PD, PB, MJSW, FC)
               + TT * ibd;

    double icbs = ddt(qbs);
    double icbd = ddt(qbd);
    current_source<>(icbs) [si, bulk];
    current_source<>(icbd) [di, bulk];

    // ── Gate capacitance: overlaps + Meyer ──────────────────────────────────
    // Capacitors are symmetric, so the overlaps are spelled exactly as in the
    // NMOS.
    C<CGSO * W>()              [gate, source];
    C<CGDO * W>()              [gate, drain];
    C<CGBO * (L - 2.0 * LD)>() [gate, bulk];

    double vgd = V(si) - V(gate) - (V(si) - V(di));   // = Vdg, the flipped Vgd
    double vgb = V(bulk) - V(gate);

    double capgs = 0.0;
    double capgd = 0.0;
    double capgb = 0.0;

    if (vgst <= 0.0 - PHI) {
        capgb = 0.5 * COX;
    } else if (vgst <= 0.0 - 0.5 * PHI) {
        capgb = 0.0 - vgst * COX / (2.0 * PHI);
    } else if (vgst <= 0.0) {
        capgb = 0.0 - vgst * COX / (2.0 * PHI);
        capgs = vgst * COX / (1.5 * PHI) + COX / 3.0;
    } else {
        if (vch >= vdsat) {
            capgs = COX / 3.0;
        } else {
            double vddif  = 2.0 * vdsat - vch;
            double vddif1 = vdsat - vch;
            double vddif2 = vddif * vddif;
            capgd = COX * (1.0 - vdsat * vdsat / vddif2) / 3.0;
            capgs = COX * (1.0 - vddif1 * vddif1 / vddif2) / 3.0;
        }
    }

    double qgs = capgs * vgs_true;
    double qgd = capgd * vgd;
    double qgb = capgb * vgb;

    double igs = ddt(qgs);
    double igd = ddt(qgd);
    double igb = ddt(qgb);

    // Reversed pairs, matching the flipped coordinates the charges were
    // written in.
    current_source<>(igs) [si,   gate];
    current_source<>(igd) [di,   gate];
    current_source<>(igb) [bulk, gate];
}

// ─────────────────────────────────────────────────────────────────────────────
//  Three-terminal wrapper: n-well tied to source. See nmos.hvr's wrapper.
// ─────────────────────────────────────────────────────────────────────────────

analog module PMOS<double VTO,  double KP,   double GAMMA, double PHI, double LAMBDA,
                   double W,    double L,    double LD,
                   double RD,   double RS,
                   double TOX,  double CGSO, double CGDO,  double CGBO,
                   double IS,   double N,    double PB,
                   double CBD,  double CBS,  double CJ,    double MJ,
                   double CJSW, double MJSW, double FC,    double TT,
                   double AD,   double ASRC, double PD,    double PSRC,
                   double VT>()
    [wire gate, wire drain, wire source]
{
    module m = PMOS4<VTO, KP, GAMMA, PHI, LAMBDA,
                     W, L, LD,
                     RD, RS,
                     TOX, CGSO, CGDO, CGBO,
                     IS, N, PB,
                     CBD, CBS, CJ, MJ,
                     CJSW, MJSW, FC, TT,
                     AD, ASRC, PD, PSRC,
                     VT>()
                    [gate, drain, source, source];
}
