from <math> import exp, sqrt, log, pow, tan, pnjlim;

// ─────────────────────────────────────────────────────────────────────────────
//  Gummel-Poon shared core — the polarity-independent half of the BJT models.
//
//  npn.hvr and pnp.hvr differ only in which terminal voltages are subtracted
//  from which and in which way the current sources point. Everything below
//  works on already-signed junction voltages, so both files share it verbatim.
//  It lives here rather than being duplicated because these functions land at
//  flat file scope in the generated C++: two copies in one compilation is a
//  redefinition, not two private helpers.
//
//  The junction limiter is NOT here — it is math's pnjlim(), which these
//  models call directly. It is general to any pn junction rather than
//  specific to a BJT, so it belongs in math beside limexp().
//
//  See npn.hvr for the model commentary.
// ─────────────────────────────────────────────────────────────────────────────

// Junction exponential, overflow-guarded by LINEAR EXTRAPOLATION rather than by
// clamping — math's limexp() specialised to a junction argument.
//
// This is the most important numerical property in the file. Hover's solvers
// are true Newton: vm_compute_jacobian (runtime/vm/vm.cpp) builds a full
// Jacobian by perturbing every node voltage and re-running the analog blocks,
// so whatever slope this function has, the solver measures it and uses it. A
// hard clamp (`if (x > 40) x = 40`) has slope EXACTLY ZERO past the threshold,
// which hands Newton a singular column: no gradient, no step, no recovery.
// That is divergence, not safety.
//
// Extrapolating keeps value and slope continuous at the seam (d/dx e^x = e^x,
// so one constant serves as both) and the derivative is never zero. An iterate
// that overshoots gets a large but finite current AND a usable gradient to
// climb back down.
//
// The threshold is on the argument rather than the voltage, so it scales with
// each junction's own emission coefficient. e^40 ~ 2.4e17 is far outside any
// physical bias.
func double jexp(double v, double nvt) {
    double x = v / nvt;
    if (x >  40.0) { x =  40.0; }
    if (x < -40.0) { x = -40.0; }
    return exp(x);
}

// vcrit — the junction voltage at which the exponential's curvature starts to
// dominate, i.e. where limiting has to begin. Below it the diode equation is
// tame enough that an unlimited step is harmless.
func double vcrit_of(double Is, double nvt) {
    double arg = nvt / (1.41421356237 * Is);
    if (arg < 1.0) { return 0.0; }   // absurdly large Is: limit everywhere
    return nvt * log(arg);
}

// q_dep — junction depletion charge, the integral of the GP depletion
// capacitance Cj/(1 - v/Vj)^Mj.
//
// Below Fc*Vj that integral is closed-form. Above it the capacitance law is
// replaced by its tangent line, because the true law has a pole at v = Vj and
// a forward-biased junction sits right on top of it — pow() would be handed a
// negative base and return NaN. The F1/F2/F3 grouping is SPICE's, and it is
// built so BOTH the charge and its slope match at the v = Fc*Vj seam: a kink
// there would be a discontinuity in capacitance, which the solver would feel
// as a spurious current spike every time a junction crossed it.
func double q_dep(double v, double Cj, double Vj, double Mj, double Fc) {
    if (Cj <= 0.0) { return 0.0; }

    double vf = Fc * Vj;
    if (v < vf) {
        return Cj * Vj / (1.0 - Mj) * (1.0 - pow(1.0 - v / Vj, 1.0 - Mj));
    }

    double f1 = Vj * (1.0 - pow(1.0 - Fc, 1.0 - Mj)) / (1.0 - Mj);
    double f2 = pow(1.0 - Fc, 1.0 + Mj);
    double f3 = 1.0 - Fc * (1.0 + Mj);
    return Cj * (f1 + (f3 * (v - vf)
                       + (Mj / (2.0 * Vj)) * (v * v - vf * vf)) / f2);
}

// rb_of — current-dependent base resistance.
//
// A real base is not a resistor: the current crowds toward the emitter edge as
// injection rises, so the effective path shortens and Rb falls from RB toward
// the high-current floor RBM. Two formulations, matching SPICE's:
//
//   Irb <= 0   the base-charge form, Rbm + (Rb - Rbm)/qb — cheap, and tied to
//              the same qb that already carries Early and high injection.
//   Irb  > 0   the Berkeley current form, where Irb is the base current at
//              which Rb has fallen to about half way to Rbm.
//
// The z-series has a removable singularity at ib -> 0: (tan z - z)/(z tan^2 z)
// tends to 1/3, which is why the small-z branch returns Rb exactly rather than
// evaluating 0/0. At the other end z approaches pi/2 from below and the same
// group tends to 0, so Rb_eff -> Rbm. Both limits are correct by construction.
func double rb_of(double Rb, double Rbm, double Irb, double ib, double qb) {
    if (Rbm <= 0.0) { return Rb; }    // RBM unset: constant base resistance
    if (Rbm >= Rb)  { return Rbm; }

    if (Irb <= 0.0) {
        if (qb < 1.0e-9) { return Rb; }
        return Rbm + (Rb - Rbm) / qb;
    }

    if (ib <= 0.0) { return Rb; }
    double x = ib / Irb;
    double z = (-1.0 + sqrt(1.0 + 14.5924348 * x)) / (2.4317084 * sqrt(x));
    if (z < 1.0e-4) { return Rb; }
    double tz = tan(z);
    return Rbm + 3.0 * (Rb - Rbm) * (tz - z) / (z * tz * tz);
}
