from <math> import pnjlim, jexp, vcrit_of;

// ═══════════════════════════════════════════════════════════════
//  LED DEVICE MODEL (generic — reusable for any color)
// ═══════════════════════════════════════════════════════════════
//
// Same diode equation as a rectifier diode (Is*(e^(V/nVt) - 1)), but LEDs
// typically run a much smaller Is and a higher ideality factor n than a
// silicon diode, which pushes Vf up into the 1.8-3V range depending on
// color and makes the exponential noticeably steeper right at turn-on.
// That steepness is exactly the case the manual's nr_prev() junction
// limiting (13.1) is built for, so this model uses it rather than a bare
// hard clamp: each NR iteration's voltage guess is bounded to move at
// most one thermal-voltage-scaled step from the previous iterate.
//
// light_out is a second, purely-informational port: luminous intensity
// driven onto it as a voltage, proportional to forward current. Units are
// illustrative ("relative light output"), not a calibrated photometric
// quantity — scale eta yourself if you need real lm/mW numbers.

analog module LED<double Is, double n, double Vt, double Vf_clamp, double eta>()
[wire anode, wire cathode, wire light_out]
{
    double nVt = n * Vt;

    // Per-iteration junction limiting, via math's pnjlim() — the same limiter
    // the diode and both BJT polarities use.
    //
    // This REPLACED a hard clamp of the form
    //     dv = vNew - vOld; if (dv > nVt) dv = nVt; ... vLim = vOld + dv;
    // which has a defect no hard clamp can avoid: while it is clamping, vLim is
    // vOld +- nVt and does not depend on vNew at all, so d(vLim)/dV is exactly
    // ZERO. Hover measures the Jacobian numerically THROUGH the analog block, so
    // a clamping LED contributes no conductance to the matrix — Newton goes
    // blind to the diode during precisely the violent iterate the clamp exists
    // to survive, which is self-reinforcing: a blind Newton takes a big step,
    // the big step keeps the clamp engaged.
    //
    // Berkeley's pnjlim() compresses logarithmically instead, so its slope past
    // the seam is small but never zero. That is why every other junction in this
    // library already uses it.
    //
    // This became load-bearing when vm_solve_op started supplying a Jacobian: a
    // Jacobian-free .op did not care what the limiter's slope was, so the clamp
    // survived unnoticed. With the Jacobian in play, redled.hvr and
    // multiple_leds.hvr stopped converging at .op alpha = 0.40 until this
    // changed.
    double vLim = pnjlim(V(anode) - V(cathode),
                         nr_prev(V(anode) - V(cathode)),
                         nVt, vcrit_of(Is, nVt));

    // Vf_clamp is kept as a last-resort ceiling for a cold start with no NR
    // history; pnjlim handles every subsequent iterate. jexp() below guards the
    // EXPONENT rather than the voltage, so deep reverse bias cannot overflow
    // without flattening the derivative the way a clamp on vLim would.
    if (vLim > Vf_clamp) { vLim = Vf_clamp; }

    double id = Is * (jexp(vLim, nVt) - 1.0);
    current_source<>(id) [anode, cathode];

    // Optical output. The diode equation's own exponential already gives
    // a realistic sharp turn-on near Vf, so no separate threshold term is
    // layered on top — light just tracks forward current directly.
    double luminous_intensity = 0.0;
    if (id > 0.0) { luminous_intensity = eta * id; }
    voltage_source<>(luminous_intensity) [light_out, gnd];
}