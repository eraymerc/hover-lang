from <math> import pnjlim, jexp, vcrit_of;

// ═══════════════════════════════════════════════════════════════
//  LED DEVICE MODEL (generic — reusable for any color)
// ═══════════════════════════════════════════════════════════════
//
// Same diode equation as a rectifier diode (Is*(e^(V/nVt) - 1)), but LEDs
// typically run a much smaller Is and a higher ideality factor n than a
// silicon diode, which pushes Vf up into the 1.8-3V range depending on
// color and makes the exponential noticeably steeper right at turn-on.
// That steepness is exactly the case the manual's nr_prev() junction
// limiting (13.1) is built for, so this model uses it rather than a bare
// hard clamp: each NR iteration's junction voltage is bounded to move a
// logarithmically compressed step from the one it used at the previous
// iterate (nr_prev(vl)).
//
// light_out is a second, purely-informational port: luminous intensity
// driven onto it as a voltage, proportional to forward current. Units are
// illustrative ("relative light output"), not a calibrated photometric
// quantity — scale eta yourself if you need real lm/mW numbers.

analog module LED<double Is, double n, double Vt, double Vf_clamp, double eta>()
[wire anode, wire cathode, wire light_out]
{
    double nVt = n * Vt;

    // Junction limiting, SPICE's way: the limiter moves the point the diode
    // is linearised at, never the slope.
    //
    // pnjlim() (and the Vf_clamp ceiling, a last resort for a cold start with
    // no Newton history) give vd, a voltage near the previous iterate. The
    // current is then the diode's tangent line at vd, evaluated at the TRUE
    // voltage v:
    //
    //     id = f(vd) + f'(vd) * (v - vd)          (SPICE's companion model)
    //
    // with vd = nodiff(...) so the Jacobian sees the conductance f'(vd) and
    // nothing of the limiter. At a solution the limiter is idle, vd = v and id
    // is the diode equation exactly.
    //
    // Until 2026-11-13 the limited voltage went straight into f(): the
    // Jacobian then differentiated THROUGH pnjlim, whose slope past its seam is
    // nVt / v — 3e-8 at a megavolt — so a limiting LED looked like an open
    // circuit to Newton, and above Vf_clamp the current was flat (dI/dV = 0).
    // A 1.5 mA step into an LED || 1 GOhm then "converged" with the anode at
    // 1.5 MV and 30 pA in the LED (docs/hoveR_sorunlar.txt item 41). Before
    // that, a hard clamp on vLim had made the slope exactly zero.
    double v  = V(anode) - V(cathode);
    double vl = pnjlim(V(anode) - V(cathode), nr_prev(vl), nVt, vcrit_of(Is, nVt));
    if (vl > Vf_clamp) { vl = Vf_clamp; }
    double vd = nodiff(vl);

    // jexp() guards the EXPONENT, so deep reverse bias cannot overflow.
    double e  = jexp(vd, nVt);
    double id = Is * (e - 1.0) + Is * e / nVt * (v - vd);
    current_source<>(id) [anode, cathode];

    // Optical output. The diode equation's own exponential already gives
    // a realistic sharp turn-on near Vf, so no separate threshold term is
    // layered on top — light just tracks forward current directly.
    double luminous_intensity = 0.0;
    if (id > 0.0) { luminous_intensity = eta * id; }
    voltage_source<>(luminous_intensity) [light_out, gnd];
}