from <math> import exp, log1p;

// ─────────────────────────────────────────────────────────────────────────────
//  Switched-resistor inverter bridges — switch cell, leg, H-bridge, three-phase
//
//  The "level C" model, in the style of PLECS and PSIM: every power switch is
//  a gate-controlled resistor with an anti-parallel freewheeling diode, and an
//  optional output capacitance across the pair.
//
//                 p
//                 │
//          ┌──────┼──────┬──────┐
//          │      │      │      │
//        Ron/   diode   Coss   (gate witness:
//        Roff    ▲ │     ═      see "Using it")
//          │      │      │
//          └──────┼──────┴
//                 │
//                 n
//
//    switch   g > 0.5:  i = (V(p) - V(n)) / Ron       (closed)
//             else:     i = (V(p) - V(n)) / Roff      (open)
//    diode    anode at n, cathode at p: it carries current from n to p, which
//             is the freewheeling direction of an IGBT/MOSFET's body or
//             co-packaged diode
//    Coss     a linear capacitor across p-n (may be 0)
//
//  Compared with the ideal switching-function bridge (<power/inverter/ideal>),
//  a leg here has a third state: both switches off. That is what dead time is,
//  and in it the load current picks its own path through one of the two
//  diodes, so the bridge node sits at dc_p + Vf or dc_n - Vf depending on the
//  current's sign, not on the gate command. Everything that follows from that
//  is captured:
//    - the dead-time voltage error, Vdc * t_dead * f_sw per leg, opposing the
//      current, with the low-order harmonics it adds to the output;
//    - diode freewheeling, discontinuous conduction, a bridge with all gates
//      off acting as a diode rectifier (pre-charge, regeneration into the bus);
//    - conduction loss: Ron * i^2 in a switch, Vf * i + Rd * i^2 in a diode;
//    - with Coss > 0, the node's finite slew during dead time: at light load
//      the current cannot swing the node across the bus within t_dead, the
//      incoming switch then turns on into a partly charged node (hard
//      switching: the stored charge is dumped through Ron, a switching loss),
//      and the dead-time error shrinks, which is why the error is smaller
//      near the current's zero crossings.
//
//  ── What it does NOT capture ───────────────────────────────────────────────
//
//  A gate edge switches the conductance instantly. So there is no gate charge,
//  no Miller plateau, no current/voltage overlap during the edge and hence no
//  switching loss beyond the Coss dump above; no turn-on/turn-off delay (put
//  those in the dead time if they matter); no diode reverse recovery (the diode
//  has no stored charge, it turns off the instant its current reaches zero); no
//  temperature dependence of Ron or Vf; no tail current; no avalanche. Ron is
//  linear, so an IGBT's knee voltage is not modelled either (raise Vf/Rd and
//  Ron to taste). For those, use device models (<semiconductors/mosfet>).
//
//  ── The diode: a smoothed piecewise-linear Vf + Rd, not the SPICE diode ────
//
//  PwlDiode below is i = (Vs/Rd) * ln(1 + e^((v - Vf)/Vs)), the "softplus"
//  of the piecewise-linear diode: (v - Vf)/Rd above Vf, zero below, with the
//  corner rounded over a width Vs (10 mV by default). Below the knee it is an
//  exponential with slope Vs, so it reads as a diode with nVt = Vs; above it
//  is a straight line of resistance Rd with no exponential left to overflow.
//
//  The stdlib SPICE diode (<semiconductors> Diode, Is/N chosen for the same
//  Vf, plus Rs) was measured against it on the switched_h_bridge benchmark
//  (24 V, 20 kHz, 300 ns dead time, 40 ms, Ron = 0.1 Ohm):
//
//                                  smoothed PWL      SPICE diode
//      Coss = 0,    Cjo = 0         1.5 s,  67k      FAILS at the first
//                                                    dead time (12.5 us)
//      Coss = 100p, Cjo = 0         3.8 s, 120k      FAILS at 314 us
//      Coss = 0,    Cjo = 100p       —               11.2 s, 103k
//      Coss = 100p, Cjo = 100p       —                7.4 s, 129k
//                                  (run time, accepted steps)
//
//  The SPICE diode fails because its Rs puts an internal node in series with
//  the junction, and that node carries no capacitance unless Cjo > 0: when the
//  dead time starts and the inductor current has to move onto the diode, the
//  junction must swing from reverse bias to full conduction in one solve, and
//  the trust-region Newton stalls on the capacitance-free node (the failure in
//  docs/hoveR_sorunlar.txt item 28). Giving it Cjo makes it run, at 2-7x the
//  cost. The smoothed PWL diode has no internal node, a slope bounded by 1/Rd,
//  and is convex, so Newton converges on it from either side without any
//  limiting. Its sharpness does not matter to the solver: Vs = 26 mV, 5 mV and
//  1 mV gave the same step count to within 3 % and output within 0.01 %.
//  Against ngspice with the same equation as a B-source, the PWL version
//  matches the fundamental to 5 digits and the bridge loss to 0.1 %.
//
//  ── Coss: why the default is 100 pF and not 0 ──────────────────────────────
//
//  Coss = 0 gives the ideal, PLECS-like commutation (the node jumps straight
//  to the diode clamp) and is the fastest: on the H-bridge benchmark 67k steps
//  against ~120k with any Coss from 3 pF to 1 nF, which the node slews cost.
//  It runs there, and in the three-phase example. But it is not safe in
//  general, for the reason in item 28: Coss is the only capacitance a bridge
//  adds, and with it at 0 any part of the circuit that reaches the rails only
//  through the switches has none. Measured on a twin of examples/MOSFET/
//  h_bridge_inverter.hvr (one capacitor straight across the output, nothing
//  from the filter to ground, Ron = 6 / 1.8 Ohm): in each dead time the whole
//  filter's common mode has to jump ~0.8 V onto the diodes in one solve, and
//  with Coss = 0 the Newton stalls at t = 11.2 ms. ngspice runs the identical
//  netlist without trouble, so this is the solver, not the circuit. With
//  Coss = 1p, 10p, 30p, 100p or 1n the same twin runs.
//
//  Very small values are not safe either: Coss = 1 pF on the benchmark (Ron *
//  2 Coss = 0.2 ps) collapses the step-size control to 1e-32 s at 9.3 ms,
//  while 3 pF and up all run. 100 pF is clear of both failures in every case
//  tried (Ron 10 mOhm to 6 Ohm, three topologies), is the right size for a small power MOSFET
//  or IGBT, and is physically harmless at amps (the node slews in nanoseconds).
//  At light load it is not harmless, and should not be: 100 mA slews the
//  200 pF on a bridge node across 24 V in 48 ns, but near the current's zero
//  crossings the swing no longer completes within the dead time. On the
//  H-bridge benchmark that takes the dead-time error from 0.39 V to 0.35 V
//  and the THD from 0.81 % to 0.61 % (ngspice agrees: 0.61 %) — partial
//  zero-voltage switching, which real hardware does too.
//
//  Set Coss = 0 deliberately, for speed, when every node of the load has its
//  own capacitance or a resistive path to the bus or ground: a split-capacitor
//  filter with a damping leg, an R-L motor load. Both examples do.
//
//  ── Using it ───────────────────────────────────────────────────────────────
//
//  Gate commands are logic signals: > 0.5 is on. A leg takes separate high-
//  and low-side commands so that both can be off — use <power/modulation/
//  deadtime> to make them from one switching command. Nothing here stops you
//  turning both on: that is a shoot-through, and with Ron = 10 mOhm on a stiff
//  bus it is exactly the short circuit it would be on the bench.
//
//  Turn on `.zcd;`. A gate edge is a discrete jump in the middle of a solver
//  step; .zcd locates it and ends the step on it. Zero-crossing detection
//  watches the sources the step drives, and a logic value that only enters the
//  circuit through an analog module's input is invisible to it, so
//  RonRoffSwitch also drives its command into a 1 Ohm resistor on a private
//  node (`gate`, a "witness": linear, decoupled from everything, and handy to
//  .save). Without it the edges still happen, but on the next step boundary.
//
//  Digital modules run in the order they are instantiated, so instantiate the
//  modulator BEFORE the dead-time generator: if the generator runs first, it
//  sees the previous step's command, .zcd cannot locate the edge, and every
//  edge lands on the next step boundary instead (measured: the first PWM edge
//  1.35 us late, and a 300 ns dead time stretched to 500 ns).
//
//  Parameters (all have defaults; pass by name, e.g. <Ron = 50m, Coss = 1n>):
//    Ron    on-state resistance                         10 mOhm
//    Roff   off-state resistance (leakage), > 0          1 MOhm
//    Vf     diode threshold voltage                      0.8 V
//    Rd     diode slope resistance, > 0                  10 mOhm
//    Coss   capacitance across each switch, may be 0     100 pF
//
//  The three wrappers draw dc_p and dc_n as bus terminals and do not assume
//  either is ground; a floating bus (split capacitors, an isolated source) is
//  fine. The DC-link current is what the bus source sees: put an ammeter or a
//  named voltage source in series with dc_p and read it with I().
// ─────────────────────────────────────────────────────────────────────────────

// Gate-controlled resistor: Roff when g <= 0.5, Ron when g > 0.5.
//
// Roff is a plain R, so it sits in the conductance matrix permanently; the
// switch adds (1/Ron - 1/Roff) on top while closed. The gate is a logic value,
// constant within a step, so the current is linear in V(p) - V(n) at every
// Newton iterate and the Jacobian is exact.
//
// The gate must NOT be read back from a circuit node (V(gate) > 0.5): Newton
// would then move the gate node itself, and every trial point that crosses
// 0.5 flips the switch — a discontinuity in the unknowns that stalled the
// solver at t = 0 when tried. Logic in, witness out.
analog module RonRoffSwitch<double Ron = 10m, double Roff = 1e6>(input double g)
    [wire p, wire n]
{
    wire gate;

    R<Roff>() [p, n];

    double on = 0.0;
    if (g > 0.5) { on = 1.0; }
    double i_sw = on * (1.0 / Ron - 1.0 / Roff) * (V(p) - V(n));
    current_source<>(i_sw) [p, n];

    // Zero-crossing witness — see the header. V(gate) == g.
    current_source<>(g) [gnd, gate];
    R<1>() [gate, gnd];
}

// Smoothed piecewise-linear diode: Vf threshold, Rd slope, corner width Vs.
//
//   i = (Vs/Rd) * (sp((v - Vf)/Vs) - sp(-Vf/Vs)),   sp(x) = ln(1 + e^x)
//
// The constant sp(-Vf/Vs) makes i(0) exactly 0. sp is evaluated in the form
// that cannot overflow on either side (x + ln(1 + e^-x) for x > 0), and both
// branches meet with equal value and slope at x = 0. GMIN (1 pS) keeps the
// branch conductance strictly positive in deep reverse bias, where e^x has
// underflowed, as the SPICE diode does.
analog module PwlDiode<double Vf = 0.8, double Rd = 10m, double Vs = 10m>()
    [wire anode, wire cathode]
{
    double v = V(anode) - V(cathode);
    double x = (v - Vf) / Vs;

    double sp = 0.0;
    if (x > 0.0) {
        sp = x + log1p(exp(0.0 - x));
    } else {
        sp = log1p(exp(x));
    }
    double sp0 = log1p(exp((0.0 - Vf) / Vs));

    double i_d = Vs / Rd * (sp - sp0) + 1.0e-12 * v;
    current_source<>(i_d) [anode, cathode];
}

// One switch with its anti-parallel diode and output capacitance.
//   p: drain / collector side, n: source / emitter side.
// Useful on its own: two of them make a buck or boost converter's switch and
// rectifier, one with g tied to 0 is a plain freewheeling diode with Roff.
module SwitchCell<double Ron = 10m, double Roff = 1e6,
                  double Vf = 0.8, double Rd = 10m, double Coss = 100p>
(input double g) [wire p, wire n]
{
    module sw = RonRoffSwitch<Ron, Roff>(g) [p, n];
    module d  = PwlDiode<Vf, Rd>() [n, p];
    C<Coss>() [p, n];
}

// One half-bridge leg. g_hi drives the switch from dc_p to a, g_lo the one
// from a to dc_n. Both off is the dead-time state; both on is shoot-through.
module SwitchedLeg<double Ron = 10m, double Roff = 1e6,
                   double Vf = 0.8, double Rd = 10m, double Coss = 100p>
(input double g_hi, input double g_lo) [wire dc_p, wire dc_n, wire a]
{
    module hi = SwitchCell<Ron, Roff, Vf, Rd, Coss>(g_hi) [dc_p, a];
    module lo = SwitchCell<Ron, Roff, Vf, Rd, Coss>(g_lo) [a, dc_n];
}

// Single-phase full bridge: two legs on one bus, output between a and b.
module SwitchedHBridge<double Ron = 10m, double Roff = 1e6,
                       double Vf = 0.8, double Rd = 10m, double Coss = 100p>
(input double g_a_hi, input double g_a_lo,
 input double g_b_hi, input double g_b_lo) [wire dc_p, wire dc_n, wire a, wire b]
{
    module leg_a = SwitchedLeg<Ron, Roff, Vf, Rd, Coss>(g_a_hi, g_a_lo) [dc_p, dc_n, a];
    module leg_b = SwitchedLeg<Ron, Roff, Vf, Rd, Coss>(g_b_hi, g_b_lo) [dc_p, dc_n, b];
}

// Three-phase two-level bridge (six switches, six diodes).
module SwitchedThreePhaseBridge<double Ron = 10m, double Roff = 1e6,
                                double Vf = 0.8, double Rd = 10m, double Coss = 100p>
(input double g_a_hi, input double g_a_lo,
 input double g_b_hi, input double g_b_lo,
 input double g_c_hi, input double g_c_lo) [wire dc_p, wire dc_n, wire a, wire b, wire c]
{
    module leg_a = SwitchedLeg<Ron, Roff, Vf, Rd, Coss>(g_a_hi, g_a_lo) [dc_p, dc_n, a];
    module leg_b = SwitchedLeg<Ron, Roff, Vf, Rd, Coss>(g_b_hi, g_b_lo) [dc_p, dc_n, b];
    module leg_c = SwitchedLeg<Ron, Roff, Vf, Rd, Coss>(g_c_hi, g_c_lo) [dc_p, dc_n, c];
}
