from <math> import floor;

// ─────────────────────────────────────────────────────────────────────────────
//  Carrier-based PWM modulators — single-phase bipolar and unipolar,
//  three-phase sine-triangle, and three-phase with min-max zero-sequence
//  injection (the carrier-based equivalent of space-vector PWM)
//
//  Every modulator here is a digital module: it compares a normalised
//  reference against a triangle carrier and emits switching functions
//  s in {0, 1}, one per bridge leg, 1 meaning "top switch on". They are meant
//  to drive the switching-function bridges of <power/inverter/ideal>, but the
//  outputs are plain gate commands and can drive anything.
//
//  The reference is an INPUT, normalised to [-1, 1] (ref = +1 asks for the
//  leg at dc_p, -1 for dc_n, 0 for the midpoint on average), so the same
//  modulator serves an open-loop sine, a closed-loop current controller or a
//  recorded profile: produce `ref` in a module of your own and wire it in, in
//  any order — the compiler runs a module that writes a signal before the
//  modules that read it (compiler/elaborator/order.go).
//
//  ── The carrier ────────────────────────────────────────────────────────────
//
//  triangle_carrier(t, f_sw) is a symmetric triangle on [-1, 1] at f_sw,
//  starting at -1 at t = 0 and peaking at t = 1/(2 f_sw): a unit sawtooth
//  `frac` folded at 1/2. It is computed from `time`, not integrated, so it
//  never drifts. All the modulators share it, so every leg in a bridge sees the
//  same carrier — which is what makes the carrier harmonic cancel in the
//  line-to-line voltage of a three-phase bridge.
//
//  Comparison is natural sampling: the leg switches at the instant the
//  reference crosses the carrier. Run the deck with `.zcd;` so the solver
//  places each of those instants exactly; without it every edge is late by up
//  to one solver step, which shows up as low-order harmonic distortion.
//
//  ── Schemes ────────────────────────────────────────────────────────────────
//
//  SpwmBipolar   s_a = ref > tri, s_b = 1 - s_a. The bridge output swings
//                between +Vdc and -Vdc. Fundamental m*Vdc (m = |ref| peak);
//                switching harmonics grouped around f_sw, 2 f_sw, …, the first
//                group being the carrier itself plus sidebands f_sw ± 2k f_out.
//  SpwmUnipolar  s_a = ref > tri, s_b = -ref > tri. The output steps between
//                0 and ±Vdc; the odd carrier groups cancel between the legs,
//                so the first harmonic group sits at 2 f_sw (sidebands
//                2 f_sw ± f_out, ± 3 f_out, …) — twice the effective ripple
//                frequency for the same device switching rate. Fundamental
//                m*Vdc, as bipolar.
//  Spwm3         three sine-triangle comparisons on one carrier. Phase-voltage
//                fundamental m*Vdc/2, linear for m <= 1. The carrier harmonic
//                and its triplen sidebands are common mode and vanish from the
//                line-to-line voltages.
//  Spwm3MinMax   as Spwm3 after adding the zero-sequence signal
//                v0 = -(max(ref) + min(ref))/2 to all three references. This
//                centres the active vectors in each carrier period, which is
//                exactly what centred space-vector PWM does, and extends the
//                linear range to m <= 2/sqrt(3) = 1.155. v0 is common mode: it
//                leaves line-to-line voltages, and the currents of a floating-
//                neutral load, unchanged.
//
//  ── What these do NOT do ───────────────────────────────────────────────────
//
//  No dead time (insert it in the gate driver or use a bridge model that has
//  one), no minimum pulse width, no regular (sample-and-hold) sampling — the
//  reference is compared continuously — and no overmodulation handling: past
//  the linear range the comparison simply saturates into pulse dropping, as a
//  plain comparator would.
// ─────────────────────────────────────────────────────────────────────────────

// Symmetric triangle on [-1, 1], period 1/f_sw, -1 at t = 0.
func double triangle_carrier(double t, double f_sw) {
    double ph   = t * f_sw;
    double frac = ph - floor(ph);
    double tri  = 4.0 * frac - 1.0;
    if (frac >= 0.5) { tri = 3.0 - 4.0 * frac; }
    return tri;
}

// Single-phase bipolar (two-level) sine-triangle PWM for an H-bridge.
digital module SpwmBipolar<double f_sw>
    (input double ref, output double s_a, output double s_b) []
{
    double tri = triangle_carrier(time, f_sw);
    s_a = 0.0;
    if (ref > tri) { s_a = 1.0; }
    s_b = 1.0 - s_a;
}

// Single-phase unipolar (three-level) sine-triangle PWM for an H-bridge.
digital module SpwmUnipolar<double f_sw>
    (input double ref, output double s_a, output double s_b) []
{
    double tri = triangle_carrier(time, f_sw);
    s_a = 0.0;
    s_b = 0.0;
    if (ref > tri)       { s_a = 1.0; }
    if (0.0 - ref > tri) { s_b = 1.0; }
}

// Three-phase sine-triangle PWM, one shared carrier.
digital module Spwm3<double f_sw>
    (input double ref_a, input double ref_b, input double ref_c,
     output double s_a, output double s_b, output double s_c) []
{
    double tri = triangle_carrier(time, f_sw);
    s_a = 0.0;
    s_b = 0.0;
    s_c = 0.0;
    if (ref_a > tri) { s_a = 1.0; }
    if (ref_b > tri) { s_b = 1.0; }
    if (ref_c > tri) { s_c = 1.0; }
}

// Three-phase PWM with min-max zero-sequence injection (centred SVPWM).
digital module Spwm3MinMax<double f_sw>
    (input double ref_a, input double ref_b, input double ref_c,
     output double s_a, output double s_b, output double s_c) []
{
    double vmax = ref_a;
    if (ref_b > vmax) { vmax = ref_b; }
    if (ref_c > vmax) { vmax = ref_c; }
    double vmin = ref_a;
    if (ref_b < vmin) { vmin = ref_b; }
    if (ref_c < vmin) { vmin = ref_c; }
    double v0 = 0.0 - 0.5 * (vmax + vmin);

    double tri = triangle_carrier(time, f_sw);
    s_a = 0.0;
    s_b = 0.0;
    s_c = 0.0;
    if (ref_a + v0 > tri) { s_a = 1.0; }
    if (ref_b + v0 > tri) { s_b = 1.0; }
    if (ref_c + v0 > tri) { s_c = 1.0; }
}
