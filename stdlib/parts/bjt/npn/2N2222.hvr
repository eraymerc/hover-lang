import <semiconductors/bjt> as dev;

// ─────────────────────────────────────────────────────────────────────────────
//  2N2222A — 40 V / 800 mA general-purpose NPN switch (TO-18/TO-92)
//
//  Parameters are the standard PSpice/Berkeley model card, transcribed into
//  Gummel-Poon argument order. Card values used verbatim:
//
//    Is=14.34f  Bf=255.9  Br=6.092  Vaf=74.03  Ikf=.2847  Ise=14.34f
//    Ne=1.307   Nc=2      Rb=10     Rc=1       Cje=22.01p Mje=.377
//    Vje=.75    Cjc=7.306p Mjc=.3416 Vjc=.75   Fc=.5      Tf=411.1p
//    Tr=46.91n
//
//  Deviations from the card, all forced by what the model supports:
//
//    Re    The card specifies no emitter resistance. R<0> is a short, so a
//          negligible 1 mOhm stands in. At 100 mA that is 0.1 mV — below the
//          resolution of anything you would measure.
//    Cjs   No substrate capacitance on a discrete card. Set to 2 pF, which
//          is a realistic collector-emitter capacitance for a TO-92 part and
//          is also REQUIRED: it is the only capacitive coupling between the
//          internal collector and emitter nodes, and at 0 the nonlinear loop
//          there loses its damping path and the solve fails outright.
//    Var   Not on the card, so 0 (= infinite reverse Early), per SPICE.
//    Rbm   Not on the card, so 0, which this model reads as "base resistance
//    Irb   is constant at Rb" — exactly the card's meaning.
//    Vt    Fixed at 0.026 V (~28 C). The card's Xti/Eg/Xtb temperature
//          scaling is not modelled, so this part is a room-temperature model.
//
//  Also not modelled, and present on the card: Itf=.6 Vtf=1.7 Xtf=3, the
//  transit-time modulation. Tf is therefore constant and fT does not fall off
//  at high current. This matters above roughly 100 mA.
//
//  Validated in this configuration: Gummel plot beta peaking at 177 near
//  35 mA with roll-off at both ends, and Vce(sat) = 89 mV at 48 mA with a
//  forced beta of 12.
// ─────────────────────────────────────────────────────────────────────────────

analog module Q2N2222<>()[wire base, wire collector, wire emitter] {
    module q = dev.NPN<14.34f, 1.0, 1.0,        // Is, Nf, Nr
                       255.9, 6.092,            // Bf, Br
                       74.03, 0.0,              // Vaf, Var
                       0.2847, 0.0,             // Ikf, Ikr
                       14.34f, 1.307,           // Ise, Ne
                       0.0, 2.0,                // Isc, Nc
                       10.0, 0.0, 0.0,          // Rb, Rbm, Irb
                       1m, 1.0,                 // Re, Rc
                       22.01p, 0.75, 0.377,     // Cje, Vje, Mje
                       7.306p, 0.75, 0.3416,    // Cjc, Vjc, Mjc
                       0.5, 411.1p, 46.91n,     // Fc, Tf, Tr
                       2p, 0.026>()             // Cjs, Vt
                      [base, collector, emitter];
}
