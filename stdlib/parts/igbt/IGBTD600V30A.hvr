import <semiconductors/igbt> as dev;

// ─────────────────────────────────────────────────────────────────────────────
//  IGBTD600V30A — generic 600 V / 30 A IGBT with co-packaged anti-parallel
//                 fast-recovery diode, TYPICAL values
//
//  NOT a manufacturer part: the IGBT600V30A.hvr typical IGBT (read its header
//  for the transistor's numbers and their basis) plus a typical soft fast-
//  recovery diode of the kind sold in the same TO-247 package. This is the
//  bridge-leg device: in a half bridge the diode of one switch carries the
//  load current through the dead time and the other switch's off-time.
//
//  ── Diode values (typical for a 600 V / 30 A co-pack FRD) ──────────────────
//
//    IS_D = 10n, N_D = 1.8   VF = 1.32 V at 30 A with RS_D (typ. 1.3-1.8 V)
//    RS_D = 10m
//    CJO_D = 200p, VJ_D = 0.7, M_D = 0.5
//    TT_D = 50n             stored charge TT * IF: 1 uC at 20 A, recovered
//                           almost entirely as Qrr when the commutation is
//                           fast. SPICE's TT recovery is abrupt (see
//                           <semiconductors>' Diode): with no stray inductance
//                           in the loop the IGBT's turn-on drives it at
//                           several A/ns and the peak reverse current is
//                           large — 80 A from 20 A in the zero-inductance
//                           double-pulse example.
//
//  Not modelled: diode breakdown (the IGBT blocks the bus), soft-recovery
//  shaping beyond the TT charge, temperature.
// ─────────────────────────────────────────────────────────────────────────────

analog module IGBTD600V30A<>()[wire gate, wire collector, wire emitter] {
    module q = dev.IGBTD<5.5, 3.0, 0.002,              // VTH, KP, LAMBDA
                         0.5, 1n, 1.3, 400n,           // BF, IS, N, TF
                         5m, 2.0, 30.0,                // RC, RG, BVR
                         1.55n, 350p, 500p, 0.5, 0.5,  // CGE, CGC, CCE, VJ, MJ
                         10n, 1.8, 10m,                // IS_D, N_D, RS_D
                         200p, 0.7, 0.5, 50n,          // CJO_D, VJ_D, M_D, TT_D
                         0.026>()                      // VT
                        [gate, collector, emitter];
}
