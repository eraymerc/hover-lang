import <electromechanical> as em;

// ─────────────────────────────────────────────────────────────────────────────
//  PMDC24V_100W — TYPICAL small 24 V permanent-magnet brushed DC motor
//
//  A generic, illustrative parameter set of the ~100 W class (a 50–60 mm
//  can motor) — NOT the data of any particular manufacturer's motor.
//
//    Ra = 1.0 Ohm    La = 1 mH    K = 0.07 V·s/rad = 0.07 N·m/A
//    J  = 2e-5 kg·m² (rotor)       B = 1e-5 N·m·s/rad
//
//  On 24 V (DCMachinePM's straight-line speed–torque curve):
//
//    no-load speed     342 rad/s (3270 rpm), 0.05 A
//    stall             24 A, 1.68 N·m
//    at 0.3 N·m        282 rad/s (2690 rpm), 4.29 A, 84 W out, 82 % eff.
//    time constants    electrical La/Ra = 1 ms, mechanical J·Ra/K² = 4.1 ms
//                      (a 24 V step from rest: eigenvalues −431 and −569 s⁻¹,
//                      peak inrush 17.7 A; the model follows the analytic
//                      solution to 3e-4 A at a 10 µs ceiling)
//
//  No brush drop, no armature reaction. Ports [ap, an, shaft]: V(shaft) is
//  the speed in rad/s, current the torque in N·m.
// ─────────────────────────────────────────────────────────────────────────────

module PMDC24V_100W<>
    (output double omega_m_out, output double i_a_out,
     output double theta_m_out, output double torque_out)
    [wire ap, wire an, wire shaft]
{
    module m = em.DCMachinePM<1.0, 1m, 0.07, 20u, 10u>
                   (omega_m_out, i_a_out, theta_m_out, torque_out)
                   [ap, an, shaft];
}
