// ─────────────────────────────────────────────────────────────────────────────
//  IPMSM — interior permanent-magnet synchronous machine
//
//  PMSM under its explicit name, with the same parameters, outputs and ports:
//  separate Ld and Lq (normally Lq > Ld, the magnets buried in the rotor
//  iron), so the torque has a reluctance term,
//
//      T_em = 1.5·p·(flux_m·iq + (Ld − Lq)·id·iq),
//
//  which a negative id (field weakening, MTPA) turns into extra torque. See
//  pmsm.hvr for the equations, units, the shaft convention and what is not
//  modelled.
// ─────────────────────────────────────────────────────────────────────────────

module IPMSM<double Rs, double Ld, double Lq, double flux_m, double p,
             double J, double B, double theta0>
    (output double omega_m_out, output double i_d_out, output double i_q_out,
     output double theta_e_out, output double torque_out)
    [wire va, wire vb, wire vc, wire shaft]
{
    module m = PMSM<Rs, Ld, Lq, flux_m, p, J, B, theta0>
                   (omega_m_out, i_d_out, i_q_out, theta_e_out, torque_out)
                   [va, vb, vc, shaft];
}
