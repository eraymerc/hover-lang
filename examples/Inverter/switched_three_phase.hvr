// ─────────────────────────────────────────────────────────────────────────────
//  HVR Testbench — switched-resistor three-phase inverter into an RL motor load
//  Validates: the two-level six-switch bridge of <power/inverter/switched>,
//             three-phase sine-triangle PWM with per-leg dead time, diode
//             freewheeling of an inductive load, and the floating star point
// ─────────────────────────────────────────────────────────────────────────────
//
//  A 48 V bus feeds a star-connected R-L load (10 Ohm + 5 mH per phase, the
//  stand-in for a small motor winding at standstill) through the switched
//  bridge. Each phase is modulated against one shared 20 kHz triangle at
//  m = 0.8, 50 Hz, and every leg gets 500 ns of dead time. The star point is
//  NOT grounded: it floats wherever the three phase currents put it, as in a
//  real drive, and its voltage (main.n) carries the triple-frequency and
//  switching-frequency common mode.
//
//                 ┌──── a ──[10 R]──[5 mH]──┐
//      48 V ── bridge ─ b ──[10 R]──[5 mH]──┼── n (floating)
//                 └──── c ──[10 R]──[5 mH]──┘
//
//  ── Expected result ─────────────────────────────────────────────────────────
//
//  Sine-triangle PWM gives a phase (leg-to-star) fundamental of m * Vdc / 2 =
//  19.2 V peak. The load is |Z| = |10 + j 2 pi 50 5m| = 10.12 Ohm at an 8.9 deg
//  lag, so an ideal bridge would drive 1.897 A peak per phase. Dead time costs
//  each leg t_dead * f_sw * Vdc = 0.48 V on average, in a square wave that
//  follows the sign of its phase current; its fundamental, 4/pi * 0.48 =
//  0.61 V, is a balanced three-phase set, so it passes to the load whole and
//  subtracts in phase with the current. With Ron in the path and Vf in the
//  dead-time windows that predicts 1.827 A peak at -8.59 deg.
//
//  Measured (74k steps, ~3 s): 1.826 A at -8.61 deg, phase-
//  current THD 0.68 % (to the 50th), made of the 5th (0.55 %) and 7th
//  (0.33 %) — the dead-time error's signature in a three-wire system. There
//  is no 3rd (< 0.01 %): the floating star point blocks every triplen, and
//  main.n carries them instead.
//
//  Coss is set to 0 below (see there). With Coss = 1n the node slews in ~50 ns,
//  the dead-time error shrinks a little near the current zero crossings
//  (1.831 A, THD 0.41 %), and the run takes ~3.5x as many steps to resolve
//  the slews.

.save(main.a, main.b, main.c, main.n,
      main.g_a_hi, main.g_a_lo,
      I(main.vbus), I(main.La), I(main.Lb), I(main.Lc));
.op;
.tran(0, 40m, 1u);   // two 50 Hz cycles
.solver(ndf2);
.zcd;                // locates every gate edge and dead-time turn-on

import <power/inverter/switched> as sw;
import <power/modulation/deadtime> as dt;
from <math> import sin, floor;

// ═══════════════════════════════════════════════════════════════
//  THREE-PHASE SINE-TRIANGLE MODULATOR (digital) — inline on purpose
// ═══════════════════════════════════════════════════════════════
//
//  Three references 120 deg apart against one carrier. s_x = 1 puts leg x's
//  high side on. Dead time is added downstream, per leg, by DeadTime.

digital module Spwm3<double f_out, double f_sw, double m>
(output double s_a, output double s_b, output double s_c) []
{
    double w   = 2.0 * 3.14159265358979 * f_out * time;
    double k   = 2.0 * 3.14159265358979 / 3.0;
    double r_a = m * sin(w);
    double r_b = m * sin(w - k);
    double r_c = m * sin(w + k);

    double ph   = time * f_sw;
    double frac = ph - floor(ph);
    double tri  = 4.0 * frac - 1.0;
    if (frac >= 0.5) { tri = 3.0 - 4.0 * frac; }

    s_a = 0.0;
    s_b = 0.0;
    s_c = 0.0;
    if (r_a > tri) { s_a = 1.0; }
    if (r_b > tri) { s_b = 1.0; }
    if (r_c > tri) { s_c = 1.0; }
}

module main<>() []
{
    wire vdc, a, b, c, n, xa, xb, xc;
    state double s_a = 0, s_b = 0, s_c = 0;
    state double g_a_hi = 0, g_a_lo = 0, g_b_hi = 0, g_b_lo = 0;
    state double g_c_hi = 0, g_c_lo = 0;

    voltage_source vbus<48>() [vdc, gnd];

    // Modulator first, then the three dead-time generators (instantiation
    // order is execution order for digital modules).
    module mod  = Spwm3<50, 20k, 0.8>(s_a, s_b, s_c) [];
    module dt_a = dt.DeadTime<500n>(s_a, g_a_hi, g_a_lo) [];
    module dt_b = dt.DeadTime<500n>(s_b, g_b_hi, g_b_lo) [];
    module dt_c = dt.DeadTime<500n>(s_c, g_c_hi, g_c_lo) [];

    // 50 mOhm switches, 1.0 V + 20 mOhm diodes, and Coss = 0 instead of the
    // 100 pF default: the R-L load gives every node a resistive path, so the
    // ideal commutation is safe here, and it runs ~3.5x faster.
    module bridge = sw.SwitchedThreePhaseBridge<Ron = 50m, Vf = 1.0, Rd = 20m, Coss = 0>
                    (g_a_hi, g_a_lo, g_b_hi, g_b_lo, g_c_hi, g_c_lo)
                    [vdc, gnd, a, b, c];

    // Star-connected R-L load, star point floating.
    R<10>()    [a, xa];
    R<10>()    [b, xb];
    R<10>()    [c, xc];
    L La<5m>() [xa, n];
    L Lb<5m>() [xb, n];
    L Lc<5m>() [xc, n];
}
