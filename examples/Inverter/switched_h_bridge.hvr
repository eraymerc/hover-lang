// ─────────────────────────────────────────────────────────────────────────────
//  HVR Testbench — switched-resistor H-bridge inverter, 50 Hz from 20 kHz SPWM
//  Validates: Ron/Roff switches with anti-parallel diodes (<power/inverter/
//             switched>), time-based dead time (<power/modulation/deadtime>),
//             diode freewheeling in every dead-time window, and the dead-time
//             voltage error on the reconstructed 50 Hz output
// ─────────────────────────────────────────────────────────────────────────────
//
//  The same benchmark as examples/MOSFET/h_bridge_inverter.hvr — 24 V bus,
//  bipolar sine-triangle PWM at m = 0.8, 50 Hz out of a 20 kHz carrier, 14 mH
//  per leg, 1.4 uF split filter capacitors with the 68 Ohm common-mode damping
//  leg, 200 Ohm load — with the transistors replaced by the switched-resistor
//  ("level C") bridge. Where that deck integrates gate charge and junction
//  physics at every edge, this one switches a conductance and lets a diode
//  pick up the current; 40 ms runs in about a second and a half.
//
//    vdc ──┬─ hi ─┬── a ──[14 mH]── out_p ──┬─ 1.4 uF ─┐
//          │      │                         │          ├─ 68 Ohm ─ gnd
//          │      lo                     200 Ohm       │
//          │      │                         │          │
//          └─ hi ─┼── b ──[14 mH]── out_n ──┴─ 1.4 uF ─┘
//                 lo   (low sides to gnd)
//
//  ── Expected result ─────────────────────────────────────────────────────────
//
//  The filter's gain at 50 Hz is 1/|1 - w^2 LC + j w L/R| = 1.001 (L = 28 mH
//  and C = 0.7 uF differential), so an ideal bridge would give
//  0.8 * 24 * 1.001 = 19.22 V peak. Dead time takes some of it back: in each
//  t_dead window the leg node follows the current, not the gate, and over a
//  switching period that costs each leg t_dead * f_sw * Vdc, opposing the
//  current — 2 * 300n * 20k * 24 = 0.288 V across the bridge, a square wave in
//  phase with the (nearly resistive) load current. Its fundamental is
//  4/pi * 0.288 = 0.367 V, which leaves 18.85 V; the diodes' Vf during the
//  windows and Ron add another ~0.03 V, for 18.82 V. Measured: 18.81 V peak,
//  0.81 % THD (up to the 50th), made of the 3rd and 5th harmonics the dead-
//  time square wave puts there (0.65 % and 0.35 %). ngspice, same circuit with
//  `sw` switches and the same diode as a B-source: 18.81 V, 0.81 %, and the
//  DC-link current and the bridge loss within 0.1 %.
//
//  Set both dead times below (300n) to 0 and the fundamental comes back to
//  19.20 V with no 3rd or 5th at all: that 0.39 V is the dead-time error.

.save(main.a, main.b, main.out_p, main.out_n, main.v_ref,
      main.g_a_hi, main.g_a_lo, main.g_b_hi, main.g_b_lo,
      I(main.vbus), I(main.La), I(main.Lb));
.op;
.tran(0, 40m, 1u);   // two full 50 Hz cycles
.solver(ndf2);
// Required: gate edges, and the dead-time turn-ons between them, fall inside
// solver steps. .zcd puts each one at its exact instant.
.zcd;

import <power/inverter/switched> as sw;
import <power/modulation/deadtime> as dt;
from <math> import sin, floor;

// ═══════════════════════════════════════════════════════════════
//  SINE-TRIANGLE MODULATOR (digital) — written inline on purpose
// ═══════════════════════════════════════════════════════════════
//
//  Bipolar SPWM: s_a = (ref > tri), s_b = not s_a, so a and b swing in
//  opposition and out_p - out_n is a +/-Vdc pulse train whose local average
//  is m * Vdc * sin(...). One switching command per leg; dead time is added
//  downstream by DeadTime, which is why this modulator knows nothing about it.

digital module Spwm<double vdc, double f_out, double f_sw, double m>
(output double s_a, output double s_b, output double v_ref) []
{
    double ref = m * sin(2.0 * 3.14159265358979 * f_out * time);

    // Unit-period sawtooth folded into a triangle on [-1, 1].
    double ph   = time * f_sw;
    double frac = ph - floor(ph);
    double tri  = 4.0 * frac - 1.0;
    if (frac >= 0.5) { tri = 3.0 - 4.0 * frac; }

    s_a = 0.0;
    if (ref > tri) { s_a = 1.0; }
    s_b = 1.0 - s_a;

    v_ref = ref * vdc;   // the commanded output, for comparison in the CSV
}

module main<>() []
{
    wire vdc, a, b, out_p, out_n, cm_mid;
    state double s_a = 0, s_b = 0, v_ref = 0;
    state double g_a_hi = 0, g_a_lo = 0, g_b_hi = 0, g_b_lo = 0;

    // 1. DC bus. Named, so I(vbus) is the DC-link current (negative while the
    // source delivers power: passive sign convention).
    voltage_source vbus<24>() [vdc, gnd];

    // 2. Modulator FIRST, dead-time generators after it: digital modules run
    // in instantiation order, and the generators must see this step's command.
    module mod  = Spwm<24, 50, 20k, 0.8>(s_a, s_b, v_ref) [];
    module dt_a = dt.DeadTime<300n>(s_a, g_a_hi, g_a_lo) [];
    module dt_b = dt.DeadTime<300n>(s_b, g_b_hi, g_b_lo) [];

    // 3. Power stage: 100 mOhm switches, 0.8 V + 50 mOhm diodes. Coss = 0
    // instead of the 100 pF default: an ideal commutation, and half the steps.
    // That is safe here because the split capacitors and the 68 Ohm leg give
    // every filter node its own path to ground; on a filter that reaches the
    // rails only through the bridge, keep the default (switched.hvr explains).
    // With the default 100 pF: 18.85 V, 0.61 % THD, ~2x the run time.
    module bridge = sw.SwitchedHBridge<Ron = 100m, Vf = 0.8, Rd = 50m, Coss = 0>
                    (g_a_hi, g_a_lo, g_b_hi, g_b_lo) [vdc, gnd, a, b];

    // 4. LC filter with the common-mode damping leg. Why the split capacitors
    // and the 68 Ohm are needed is explained in h_bridge_inverter.hvr.
    L La<14m>() [a, out_p];
    L Lb<14m>() [b, out_n];
    C<1.4u>()   [out_p, cm_mid];
    C<1.4u>()   [out_n, cm_mid];
    R<68>()     [cm_mid, gnd];
    R<200>()    [out_p, out_n];
}
