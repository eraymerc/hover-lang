// ─────────────────────────────────────────────────────────────────────────────
//  HVR Testbench — Phototransistor Model + Optocoupler Demo
//  Validates: Light-generated base current, current-gain amplification to
//             the collector, and direct coupling to LED.light_out.
// ─────────────────────────────────────────────────────────────────────────────

.save(main.led_anode, main.light_bus, main.pt_collector);

.tran(0, 50m, 5u);
.solver(ndf2);

from <math> import exp, sin;
from <optoelectronics/leds> import LED, LED_RED;

// ═══════════════════════════════════════════════════════════════
//  PHOTOTRANSISTOR DEVICE MODEL
// ═══════════════════════════════════════════════════════════════
//
// A phototransistor is an ordinary BJT whose base current is (mostly)
// generated by incident light hitting the base-collector junction rather
// than by an external base drive -- that's what gives it current gain
// over a plain photodiode (Ic = Bf * Iph instead of just Iph).
//
// light_in reads the same "virtual node" convention as LED.light_out, so
// the two wire together directly to model an optocoupler: no base pin is
// required for that use case, but base is still exposed (as on many real
// phototransistor packages) so it can be biased/desensitized if wanted --
// tie it to emitter through a resistor when unused, same as leaving a
// real phototransistor's base open with a stabilizing bleed resistor.
//
// Follows the same modeling style as the working NPN reference: plain
// V() reads with hard +0.75V/-5.0V physical clamps and no artificial step
// limiter, since the solver's own diagonally-scaled trust-region damping
// already handles the exponential's steepness. exp() is used directly.
//
// NOTE: this uses ideal current sources (same simplification as the NPN
// reference) -- there's no saturation region, so the demanded Ic = Bf*Ib
// will be forced through the collector regardless of what the external
// circuit can supply at a sane voltage. Size the collector load and
// responsivity together so Ic stays in a realistic range (see the
// testbench below for a worked example).
//
// IMPORTANT: driven primitive arguments (the () logic port) must be a
// plain identifier, not an inline expression -- e.g. current_source<>(Ic)
// works, current_source<>(Bf*i_b) does not (see conversation for why).

analog module Phototransistor<double Is, double Bf, double Vt, double responsivity>()
[wire base, wire collector, wire emitter, wire light_in]
{
    double vbe = V(base) - V(emitter);
    if (vbe > 0.75) { vbe = 0.75; }
    if (vbe < -5.0) { vbe = -5.0; }

    // Base-emitter junction current: dark leakage / any externally-driven
    // base current.
    double i_be = (Is / Bf) * (exp(vbe / Vt) - 1.0);

    // Photogenerated current, proportional to incident light. Light
    // intensity can't be negative, so clamp rather than let it subtract.
    double i_ph = responsivity * V(light_in);
    if (i_ph < 0.0) { i_ph = 0.0; }

    double i_b_total = i_be + i_ph;
    double i_c = Bf * i_b_total;   // pre-compute into its own identifier --
                                    // driven primitives need a plain
                                    // identifier argument, not an inline
                                    // expression (see conversation).

    current_source<>(i_b_total) [base, emitter];
    current_source<>(i_c)       [collector, emitter];

    C<10p>() [base, emitter];
    C<4p>()  [base, collector];
}

// ═══════════════════════════════════════════════════════════════
//  TOP-LEVEL TESTBENCH — LED-to-phototransistor optocoupler
// ═══════════════════════════════════════════════════════════════
//
//   vcc --R<220>--> nodeA --R<1>--> led_anode --[LED_RED]--> gnd
//                                                    |
//                                                 light_bus
//                                                    |
//   vcc --R<2.2k>--> pt_collector --[Phototransistor]--> gnd (emitter)
//                                        |
//                                    pt_base --R<1Meg>--> gnd  (bias/bleed
//                                        resistor, base otherwise unused)
//
// Is=1e-14 (typical silicon junction), Bf=500, responsivity=5e-6 A per
// light_bus unit. Red LED at ~14mA drives light_bus to ~0.7 (see the
// earlier LED conversation: eta=50 -> 50*0.014=0.7), giving
// i_ph = 5e-6*0.7 = 3.5uA, Ic = 500*3.5uA = 1.75mA -- across the 2.2k
// pull-up that pulls pt_collector down to roughly 5V - 1.75mA*2.2k ~= 1.15V
// ("lit" state) versus ~5V when the LED is off ("dark" state).

func double sineWave(double freq, double phase){
    double pi = 3.14159265;
    double w = 2.0 * pi * freq;
    return 2.5*(sin(w * time + phase)+1);
}

analog module sineSource<>()[wire p, wire n]{
    double voltage = sineWave(1k,0);
    voltage_source<>(voltage) [p, n];
    
}
module main<>() []
{
    wire vcc, nodeA, led_anode, light_bus, pt_collector, pt_base, vcc_led;
    

    module source = sineSource<>() [vcc_led, gnd];
    voltage_source<5>() [vcc, gnd];

    // LED side (optocoupler emitter)
    R<220>() [vcc_led, nodeA];
    R<1>()   [nodeA, led_anode];   // current-sense resistor
    module ledRed = LED_RED<>() [led_anode, gnd, light_bus];

    // Phototransistor side (optocoupler detector)
    R<2.2k>() [vcc, pt_collector];   // collector pull-up / load
    R<1Meg>() [pt_base, gnd];        // base bleed resistor (base unused)

    module pt = Phototransistor<1e-14, 500, 0.026, 5e-6>()
                [pt_base, pt_collector, gnd, light_bus];
}
