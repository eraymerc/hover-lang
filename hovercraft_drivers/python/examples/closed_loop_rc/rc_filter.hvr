// ─────────────────────────────────────────────────────────────────────────────
//  RC low-pass filter, driven from a host program.
//
//  Exercises the whole hovercraft surface in one small circuit:
//    <> gain      a runtime-settable static param, read by main's own logic
//    () vin       a runtime-settable scalar input, driving the source
//    () taps[3]   a runtime-settable array input
//    .save(...)   a node voltage, a logic signal and a branch current
//
//  Build + drive with hovercraft_drivers/python/examples/drive_rc.py
// ─────────────────────────────────────────────────────────────────────────────
.save(main.vout, main.drive, main.vsense);
.tran(0, 10m, 10u, 10u);
.solver(bdf2);

// Analog rather than structural: an analog module may hold both equations
// and circuit elements, which is what lets `gain` (a <> param) be read by
// real logic here. A <> param consumed only by an element value -- R<gain>
// -- would be folded to a constant at elaboration time and would NOT be
// runtime-settable; see docs/hovercraft-issues.md #6.
analog module main<double gain>(double vin, double[3] taps) []
{
    // The source voltage: the host writes vin and taps, gain scales the
    // result. All three are settable at runtime.
    double drive = gain * vin + taps[0] + taps[1] + taps[2];

    wire vin_node, vout;

    voltage_source vsense<>(drive) [vin_node, gnd];
    R<1k>()  [vin_node, vout];
    C<100n>() [vout, gnd];
}
