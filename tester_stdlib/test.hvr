// ─────────────────────────────────────────────────────────────────────────────
//  HVR Testbench — Common-Emitter BJT Amplifier
//  Validates: Active linear amplification, Phase inversion, and AC Gain
// ─────────────────────────────────────────────────────────────────────────────

.save(main.q1_base, main.q1_collector);
.tran(0, 30m, 1u, 10u); // 5 ms run, 1 µs timesteps (1 kHz sine will show 5 full cycles)
.solver(bdf2);

import <parts/bjt/npn> as npn;
from <math> import sin;
// ═══════════════════════════════════════════════════════════════
//  TOPLEVEL CIRCUIT
// ═══════════════════════════════════════════════════════════════

analog module AC_Source<double dc_bias, double ac_amp, double freq>()[wire out, wire gnd] {
    // Because this is ANALOG, the VM runs it continuously inside the matrix loop!
    double v_sig = dc_bias + ac_amp * sin(2.0 * 3.14159265359 * freq * time);
    voltage_source<>(v_sig)[out, gnd];
}

module main<>()[]
{
    wire vcc, q1_base, q1_collector, q1_emitter, v_in;

    // 1. Power Supply Rail (12V DC)
    voltage_source<20>()[vcc, gnd];

    // 2. Input Source: 1.03V DC Bias + 20mV AC Sine Wave (1 kHz)
    // The 1.03V bias holds the transistor perfectly halfway open (Ic ≈ 5mA)
    module signal_source = AC_Source<1.03, 20m, 1k>()[v_in, gnd];

    // 3. Passive Amplifier Network
    R<110k>()[vcc, q1_base];   // Rb - Base current limiter / Input impedance
    R<10k>() [vcc,  q1_collector];     // Rc - Collector load resistor (Sets the voltage gain)
    R<10k>() [q1_base,  gnd];
    R<1k>() [q1_emitter,  gnd];
    wire mid;
    C<16u>() [mid, gnd];
    C<0.34u>()[v_in,q1_base];
    R<74>() [q1_emitter, mid];  

    // 4. Transistor Under Test — 2N2222A from the parts library.
    // The full Gummel-Poon card (Early effect, high-injection knee, non-ideal
    // base current, ohmic resistances, bias-dependent charge) is inside the
    // part, so nothing has to be spelled out here.
    module Q1 = npn.Q2N2222<>()[q1_base, q1_collector, q1_emitter];
}
