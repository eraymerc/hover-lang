// ─────────────────────────────────────────────────────────────────────────────
//  Diode validation — forward sweep 0 -> 1.2 V, 1N4148 card
// ─────────────────────────────────────────────────────────────────────────────

.save(main.vsrc, main.n1);
.tran(0, 20m, 1u, 10u);
.solver(bdf2);

import <semiconductors> as dev;

analog module Ramp<double v0, double v1, double tend>()[wire out, wire gnd] {
    double v = v0 + (v1 - v0) * time / tend;
    voltage_source<>(v)[out, gnd];
}

module main<>()[]
{
    wire vsrc, n1;

    module src = Ramp<0.0, 1.2, 20m>()[vsrc, gnd];

    module D1 = dev.Diode<2.52n, 1.752,          // Is, N
                          0.568,                 // Rs
                          0.0,                   // Ikf
                          1.805n, 2.0,           // Isr, Nr
                          75.0, 100u,            // Bv, Ibv
                          4p, 0.75, 0.333, 0.5,  // Cjo, Vj, M, Fc
                          11.54n,                // Tt
                          0.026>()               // Vt
                         [vsrc, n1];

    R<10>() [n1, gnd];
}
