import "../math/math.hvr";


// ─────────────────────────────────────────────────────────────────────────────
//  NPN_EbersMoll — rewritten with limexp() in place of exp()
//
//  Identical model otherwise: same voltage clamps, same current equations,
//  same fixed junction capacitors. The only change is replacing exp(v/Vt)
//  with limexp(v/Vt) in the three current equations.
//
//  Why this targets the actual failure mode: during Newton iteration, a
//  bad intermediate guess for vbe/vbc can be far larger than the existing
//  +-0.75V/-5.0V clamps allow ONCE divided by Vt (0.026V) -- e.g. a guess
//  of just 2V, well within what a Newton step could propose before the
//  clamp lines below even run, gives v/Vt ~ 77, and exp(77) ~ 2.7e33 --
//  already enormous, and the clamp lines only bound vbe/vbc themselves,
//  not the SCALED argument actually passed to exp(). limexp() bounds the
//  scaled argument's growth directly and smoothly (continuous value AND
//  derivative at the seam -- see limexp.hvr), so a wild intermediate
//  Newton guess can no longer produce an astronomical current term that
//  throws the next iteration further off course.
//
//  This is the first of two existing safeguards in this model (the
//  explicit if-clamps on vbe/vbc, and now limexp on the exponential
//  itself) -- both are kept, since they guard against different things:
//  the clamps bound the PHYSICAL voltage range considered valid, limexp
//  bounds the NUMERICAL growth of the exponential evaluated from
//  whatever voltage (clamped or not) is currently being tried.
// ─────────────────────────────────────────────────────────────────────────────

analog module NPN_EbersMoll<double Is, double Bf, double Br, double Vt>()
    [wire base, wire collector, wire emitter]
{
    double v_b = V(base);
    double v_e = V(emitter);
    double v_c = V(collector);

    double vbe = v_b - v_e;
    double vbc = v_b - v_c;

    if (vbe > 0.75) { vbe = 0.75; }
    if (vbc > 0.75) { vbc = 0.75; }
    if (vbe < -5.0) { vbe = -5.0; }
    if (vbc < -5.0) { vbc = -5.0; }

    // Direct mathematical calculation. No states! limexp() in place of
    // exp() — see header comment for why.
    double i_be = (Is / Bf) * (limexp(vbe / Vt) - 1.0);
    double i_bc = (Is / Br) * (limexp(vbc / Vt) - 1.0);
    double i_ce = Is * (limexp(vbe / Vt) - limexp(vbc / Vt));

    current_source<>(i_be)[base, emitter];
    current_source<>(i_bc)[base, collector];
    current_source<>(i_ce)[collector, emitter];

    C<10p>() [base,      emitter];
    C<4p>()  [base,      collector];
    C<2p>()  [collector, emitter];
}
